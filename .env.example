NIM_API_KEY=put-your-nvidia-nim-key-here
# Model availability is account-specific on NVIDIA NIM. The value below works for
# the demo account; if you get 404 "Not found for account", probe alternatives:
#   curl -s https://integrate.api.nvidia.com/v1/models -H "Authorization: Bearer $YOUR_KEY"
# then test candidates against /v1/chat/completions until one answers.
NIM_MODEL=google/diffusiongemma-26b-a4b-it
